# Copy to .env and replace every placeholder with your own values.
# Never commit .env or real credentials.
mongo_uri=mongodb+srv://<username>:<password>@<cluster>/<database>
ACCESS_TOKEN=replace_with_a_long_random_access_secret
REFRESH_TOKEN=replace_with_a_different_long_random_refresh_secret
CLOUD_NAME=
API_KEY=
API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
EMAIL_HOST=
EMAIL_PASSWORD=
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,https://rent-a-ride-two.vercel.app
