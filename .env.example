# Copy this file to .env in the repository root and fill in your own values.
# Never commit the real .env file or share its values.

# Docker Compose uses the MongoDB service name.
# For MongoDB Atlas, replace this with your Atlas connection URI.
mongo_uri=mongodb://mongodb:27017/rent-a-ride

# Generate two different long random secrets (at least 32 bytes each).
ACCESS_TOKEN=replace_with_a_long_random_access_secret
REFRESH_TOKEN=replace_with_a_different_long_refresh_secret

# Cloudinary (optional until image upload is used)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Razorpay: keep the secret on the backend only.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# Gmail SMTP account and app password (optional until booking email is used).
EMAIL_HOST=
EMAIL_PASSWORD=

PORT=3000
NODE_ENV=development
# Set true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Browser origins allowed to call the API.
CLIENT_URL=http://localhost:5173,http://100.48.9.239:5173,https://rent-a-ride-two.vercel.app
