# Copy this file to .env in the repository root and fill in your own values.
# Keep .env private. Never commit real credentials.

# For Docker Compose, use the MongoDB service name (not localhost).
# To use MongoDB Atlas instead, replace this value with your Atlas connection URI.
mongo_uri=mongodb://mongodb:27017/rent-a-ride

ACCESS_TOKEN=replace_with_a_long_random_access_secret
REFRESH_TOKEN=replace_with_a_different_long_random_refresh_secret

CLOUD_NAME=
API_KEY=
API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
EMAIL_HOST=
EMAIL_PASSWORD=
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,https://rent-a-ride-two.vercel.app
