# Vite proxy target for running the frontend outside Docker on this EC2 instance.
# Docker Compose overrides this with the internal service URL: http://backend:3000
VITE_PRODUCTION_BACKEND_URL=http://100.48.9.239:3000

# Public browser-side Razorpay key ID only (never put the Razorpay secret here).
VITE_RAZORPAY_KEY_ID=

# Firebase browser API key, if Firebase features are enabled.
VITE_FIREBASE_API_KEY=
